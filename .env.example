# Copy this file to .env and fill in your keys.
# .env is git-ignored — never commit real secrets.

# --- OSINT API keys (PC1) ---
OTX_API_KEY=
# URLhaus / ThreatFox / MalwareBazaar all use the SAME abuse.ch Auth-Key.
# Free, 60-second sign-up at https://auth.abuse.ch
URLHAUS_AUTH_KEY=
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
ABUSEIPDB_API_KEY=

# --- Storage ---
DB_PATH=./data/cyberia.db

# --- API host/port (PC1) ---
API_HOST=0.0.0.0
API_PORT=8000

# --- LLM (PC2) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
